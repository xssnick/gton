      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(${metric_namespace}_collator_candidate_transactions_bucket{job=~\"$job\",instance=~\"$instance\",mode=\"validator\",chain=~\"$chain\"}[$__rate_interval])) by (le,chain))", "legendFormat": "{{chain}} tx", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(${metric_namespace}_collator_candidate_messages_bucket{job=~\"$job\",instance=~\"$instance\",mode=\"validator\",chain=~\"$chain\"}[$__rate_interval])) by (le,chain,kind))", "legendFormat": "{{chain}} {{kind}} msg", "refId": "B" },
        { "expr": "histogram_quantile(0.95, sum(rate(${metric_namespace}_collator_candidate_out_queue_messages_bucket{job=~\"$job\",instance=~\"$instance\",mode=\"validator\",chain=~\"$chain\"}[$__rate_interval])) by (le,chain))", "legendFormat": "{{chain}} out queue", "refId": "C" },
        { "expr": "histogram_quantile(0.95, sum(rate(${metric_namespace}_collator_candidate_gas_used_bucket{job=~\"$job\",instance=~\"$instance\",mode=\"validator\",chain=~\"$chain\"}[$__rate_interval])) by (le,chain))", "legendFormat": "{{chain}} gas", "refId": "D" }
      ],
      "title": "Integrated candidate load p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Rates of external-phase stop causes, final load classes, and explicit overload causes.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "fillOpacity": 18, "lineWidth": 1, "showPoints": "never", "spanNulls": true }, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 47 },
      "id": 17,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum(rate(${metric_namespace}_collator_external_stop_total{job=~\"$job\",instance=~\"$instance\",mode=\"validator\",chain=~\"$chain\"}[$__rate_interval])) by (chain,reason)", "legendFormat": "external {{chain}} / {{reason}}", "refId": "A" },
        { "expr": "sum(rate(${metric_namespace}_collator_load_class_total{job=~\"$job\",instance=~\"$instance\",mode=\"validator\",chain=~\"$chain\"}[$__rate_interval])) by (chain,class)", "legendFormat": "load {{chain}} / {{class}}", "refId": "B" },
